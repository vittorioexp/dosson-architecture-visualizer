# Database
DATABASE_URL=postgresql://archviz:archviz_secret@localhost:5432/architecture_visualizer

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dosson-architecture-visualizer
S3_REGION=us-east-1

# AI Providers (OpenAI-compatible)
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# GitHub
GITHUB_TOKEN=

# Analysis
MAX_UPLOAD_SIZE_MB=100
MAX_ZIP_ENTRIES=10000
MAX_ZIP_UNCOMPRESSED_MB=500
ANALYSIS_SANDBOX_PATH=./sandbox
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dosson-architecture-visualizer-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
